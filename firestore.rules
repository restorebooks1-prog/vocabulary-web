rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 僅允許指定的 Firebase Authentication 帳號存取個人進度。
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'n7V3jMDDigTr9qdu2VKzRX2NjPz2';
    }
    // Only the owner can read datasets; publishing also requires Google sign-in.
    match /publicDatasets/{datasetId} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && datasetId.matches('[a-z0-9][a-z0-9_-]{0,79}')
        && request.resource.data.keys().hasOnly(['schemaVersion', 'json'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 900000;
      allow delete: if isOwner()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /users/{uid}/lists/{listId} {
      allow read: if isOwner() && request.auth.uid == uid;
      allow create, update: if isOwner() && request.auth.uid == uid
        && listId.matches('[a-z0-9][a-z0-9_-]{0,79}')
        && request.resource.data.keys().hasOnly(['schemaVersion', 'words', 'filters'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.words is map
        && (request.resource.data.filters == null || request.resource.data.filters is map);
      allow delete: if isOwner() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
  }
}
